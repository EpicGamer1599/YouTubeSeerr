# Copy to .env. Secrets can also be entered in the first-run wizard.
PORT=5056
BIND_ADDRESS=0.0.0.0
TZ=Australia/Perth
PUID=1000
PGID=1000
CONFIG_PATH=./config
DOWNLOAD_PATH=./downloads
# Host directory that Jellyfin also mounts. Settings use CONTAINER paths.
MEDIA_PATH=./media/youtube
JELLYFIN_URL=http://host.docker.internal:8096
YOUTUBE_API_KEY=
JELLYFIN_API_KEY=
# Optional Netscape cookies file under the mounted /config directory.
YTDLP_COOKIES_FILE=
YTDLP_VERSION=2026.08.19

# Behind an HTTPS reverse proxy, set these:
# COOKIE_SECURE=true
# APP_ORIGIN=https://youtube.example.com
# TRUST_PROXY=1
COOKIE_SECURE=false
APP_ORIGIN=
TRUST_PROXY=0

# Native development only:
# CONFIG_DIR=./config
# DOWNLOAD_DIR=./downloads
# MEDIA_DIR=./media/youtube
# YTDLP_BIN=yt-dlp
